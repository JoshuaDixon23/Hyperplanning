@startuml
skinparam linetype ortho
skinparam nodesep 140
skinparam ranksep 130
skinparam padding 10

class User {
    name
    surname
    mail
}

class Professor {
    
}

class Student {
}

Professor -u-|> User
Student -u-|> User

class Promo{
    year
    Enum studyLevel
}

class CourseGeneric{
    code
    name
    language
}

class UFR{
    name
    campus   
}

class Group{
    Enum type (promo?, TD, TP)
}

class CourseReal{
    startTime
    duration
}

class Building{
    localisation
    openingTime
    closingTime
}

class Room{
    num
    capacity
    Enum type (TP, amphitheater etc)
}

class Map{
    city
    imageFileName
}

class Planning{
}

class Basket{
}

User -[hidden]d- Professor

Professor -[hidden]r- Student

Promo -[hidden]r- CourseGeneric
CourseGeneric -[hidden]r- UFR

Group -[hidden]r- CourseReal
CourseReal -[hidden]r- Building

Room -[hidden]r- Map
Map -[hidden]r- Basket

Professor -[hidden]d- Promo
Student -[hidden]d- CourseGeneric
CourseGeneric -[hidden]d- Group
UFR -[hidden]d- CourseReal
Building -[hidden]d- Room

Promo -[hidden]d- Group
Group -[hidden]d- Planning
CourseReal -[hidden]d- Planning

Professor "responsible" -d- "0..1" Promo
Professor "responsible" -r- "0..*" CourseGeneric 
Professor "1..*" -d- "*" CourseReal

Student "*" -d- "0..1" Promo : belongs >
Student -d-o Group

CourseGeneric "*" -l- "*" Promo : follows <
CourseGeneric "*" -d- "*" Student: follows <
CourseGeneric -d- "0..*" CourseReal : describes >

Promo *-d- Group

UFR "1" *-l- "1..*" Promo

Group "1..*" -r- "*" CourseReal

Building *-d- Room
Building -r-o Map
Building "1..*" -l- "0..1" UFR : belongs > 

Room -u- "*" CourseReal

Planning *-u- CourseReal
Planning -u- "1..*" Promo : owns <
Planning -l- "1..*" Student : owns <
Planning -l- "1..*" Professor : owns <
Planning -u- "1..*" Group: owns <

Basket o-u- CourseGeneric
Basket -l- "international" Student
@enduml
