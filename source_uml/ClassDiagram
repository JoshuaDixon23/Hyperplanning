@startuml
skinparam linetype ortho
skinparam nodesep 120
skinparam ranksep 120
skinparam padding 10

class User {
    name
    surname
    mail
}

class Professor {
    
}
class Student {
}

Professor -u-|> User
Student -u-|> User

class CourseGeneric{
    code
    name
}

class Promo{
    year
    Enum studyLevel
}

class UFR{
    name
    campus   
}

class Building{
    localisation
    openingTime
    closingTime
}

class Map{
    city
    imageFileName
}

class CourseReal{
    startTime
    duration
}

class Group{
    Enum type (promo?, TD, TP)
}

class Room{
    num
    capacity
    Enum type (TP, amphitheater etc)
}

class Basket{
}

class Planning{
}

User -[hidden]d- Professor

Professor -[hidden]r- Student

CourseGeneric -[hidden]r- Promo
Promo -[hidden]r- UFR
UFR -[hidden]r- Building
Building -[hidden]r- Map

CourseReal -[hidden]r- Group
Group -[hidden]r- Room
Room -[hidden]r- Basket

Professor -[hidden]d- CourseGeneric
Student -[hidden]d- Promo
UFR -[hidden]d- Group
Building -[hidden]d- Room

CourseGeneric -[hidden]d- CourseReal
Promo -[hidden]d- Group

CourseReal -[hidden]d- Planning
Group -[hidden]d- Planning

Professor "responsible" -d- "0..*" CourseGeneric 
Professor "responsible" -d- "0..1" Promo
Professor "1..*" -d- "*" CourseReal

Student "* " -d- "*" CourseGeneric
Student "*" -d- "0..1" Promo : belongs >
Student "*" -d- "0..*" Group: belongs >

CourseGeneric -d- "0..*" CourseReal : describes >
CourseGeneric "*" -r- "*" Promo : follows <

Promo *-d- Group
UFR "1" *-l- "1..*" Promo

Group "1..*" -l- "*" CourseReal

Building *-d- Room
Building -r-o Map
Building "1..*" -u- "0..1" UFR : belongs > 

Room -l- "*" CourseReal

Planning *-u- CourseReal
Planning -u- "1..*" Promo : owns <
Planning -l- "1..*" Student : owns <
Planning -l- "1..*" Professor : owns <
Planning -u- "1..*" Group: owns <

Basket o-u- CourseGeneric
Basket -l- "international" Student

@enduml
