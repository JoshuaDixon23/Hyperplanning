@startuml
left to right direction
'skinparam nodesep 60
'skinparam ranksep 60
'skinparam padding 8
skinparam linetype ortho
class User {
    name
    surname
    mail
}

class Professor {
    
}

class Student {

}

class CourseGeneric{
    code
    name
}

class CourseReal{
    startTime
    duration
}

class Room{
    num
    capacity
    Enum type (TP, amphitheater etc)
}

class Promo{
    year
    Enum studyLevel
}

class UFR{
    name
    campus
    
    
}

class Building{
    localisation
    openingTime
    closingTime

}

class Planning{

}

class Map{
    city
    imageFileName
}


Professor --|> User
Student --|> User


Professor "responsible" --- "0..*" CourseGeneric 
Student "*\nstudent " --- "*" CourseGeneric

Professor "responsible" --- "0..1" Promo
Student "*\nstudent " --- "0..1" Promo : belongs >

UFR "1" *-- "1..*" Promo
'CourseGeneric "1..*" --- "1..*" Promo : quelque chose
'CourseGeneric -[hidden]- Promo

Building *--  Room
Building "1..*" --- "0..1" UFR : belongs > 

Planning *--  CourseReal
Planning "1"-- "1..*" Promo : owns <
Planning "1"-- "1..*" Student : owns <
Planning "1"-- "1..*" Professor : owns <

diamond d1

Professor -- d1
Room -u- d1
Student -r- d1
d1 .l- CourseReal 

CourseGeneric  --- "0..*"CourseReal : describes >
Building --o Map

CourseGeneric "*"--"*" Promo : follows <


@enduml

