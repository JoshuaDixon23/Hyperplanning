@startuml
left to right direction

actor Invited as I
package InvitedService {
(consult planning by promo) as cp
(see map) as sp 
(consult restorations information) as cri
}


actor Student as S
package StudentService {
(search for empty room) as sfer
(consult his planning) as chp
(consult professor's planning) as cpp
(consult his promo's planning) as chpp
}

actor StaffDRI as SD
package StaffDRIService {
(manage international student's planning) as misp


}
actor Professor as P
package ProfessorService {

(consult his planning) as chppro
(request planning change) as rpc
'(specify courses info) as sci


}
actor Admin as A
package AdminService {
(manage promotion) as mpromo
(manage planing ) as mp
}

I -- cp
I -- sp
I -- cri


S -- sfer
S -- chp
S -- chpp
S -- cpp

S -|> I


SD -- misp
SD -|> I


P -- chppro
P -- rpc
'P -- sci

P -|> I

A -- mpromo
A -- mp

A -|> I

(consult planning) as consult

consult .--> mp : "extend"
A -- consult
chp <.-- consult : "extend"
cpp <.-- consult : "extend"
chpp <.-- consult : "extend"
chppro <.-- consult : "extend"
cp <.-- consult : "extend"
'chpp <.-- cp : "extend"

'(sign in) as si
'StaffDRIService .--> si : "include"
'StudentService .--> si : "include"
'AdminService .--> si : "include"
'ProfessorService .--> si : "include"
note "UCs of all the services\n except InvitedService \ninclude UC Sign In" as N1
@enduml
