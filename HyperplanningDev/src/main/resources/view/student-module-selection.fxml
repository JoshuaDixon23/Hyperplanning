<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.univtln.projet.planning.controller.InternationalStudentModuleController"
            style="-fx-background-color: #f1f5f9;">

    <!-- SIDEBAR -->
    <left>
        <fx:include source="/components/sidebar-staffDri.fxml"/>
    </left>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #f1f5f9;">

            <!-- HEADER -->
            <VBox style="-fx-background-color: white;
                         -fx-border-color: transparent transparent #e2e8f0 transparent;
                         -fx-border-width: 0 0 1 0;
                         -fx-padding: 28 40 20 40;">

                <!-- Titre page -->
                <Label text="Sélection des modules"
                       style="-fx-font-size: 13px;
                              -fx-text-fill: #64748b;
                              -fx-font-weight: 500;
                              -fx-padding: 0 0 4 0;"/>

                <!-- Nom étudiant -->
                <Label fx:id="studentNameLabel"
                       text="Nom Étudiant"
                       style="-fx-font-size: 26px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #0f172a;"/>

                <!-- Compteurs + bouton valider -->
                <HBox spacing="12" alignment="CENTER_LEFT"
                      style="-fx-padding: 16 0 0 0;">

                    <!-- Compteur modules -->
                    <HBox alignment="CENTER" spacing="0"
                          style="-fx-background-color: white;
                                 -fx-border-color: #e2e8f0;
                                 -fx-border-radius: 8;
                                 -fx-background-radius: 8;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);">
                        <Label text="Modules sélectionnés"
                               style="-fx-padding: 10 16;
                                      -fx-font-size: 13px;
                                      -fx-font-weight: 500;
                                      -fx-text-fill: #475569;"
                                      minWidth="180"/>
                        <Label fx:id="moduleCountLabel"
                               text="0"
                               style="-fx-background-color: #1e293b;
                                      -fx-text-fill: white;
                                      -fx-padding: 10 18;
                                      -fx-font-weight: bold;
                                      -fx-font-size: 14px;
                                      -fx-background-radius: 0 7 7 0;"
                                      minWidth="50"/>
                    </HBox>

                    <!-- Compteur ECTS -->
                    <HBox alignment="CENTER" spacing="0"
                          style="-fx-background-color: white;
                                 -fx-border-color: #e2e8f0;
                                 -fx-border-radius: 8;
                                 -fx-background-radius: 8;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);">
                        <Label text="ECTS"
                               style="-fx-padding: 10 16;
                                      -fx-font-size: 13px;
                                      -fx-font-weight: 500;
                                      -fx-text-fill: #475569;"/>
                        <Label fx:id="ectsCountLabel"
                               text="0"
                               style="-fx-background-color: #15803d;
                                -fx-text-fill: white;
                                -fx-padding: 10 18;
                                -fx-font-weight: bold;
                                -fx-font-size: 14px;
                                -fx-background-radius: 0 7 7 0;"
                                minWidth="50"/>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Bouton valider -->
                    <Button fx:id="validateButton"
                            text="Valider la sélection  ➜"
                            disable="true"
                            onAction="#handleValidate"
                            style="-fx-background-color: #1e293b;
                                   -fx-text-fill: white;
                                   -fx-font-size: 13px;
                                   -fx-font-weight: bold;
                                   -fx-padding: 11 24;
                                   -fx-background-radius: 8;
                                   -fx-cursor: hand;"
                            minWidth="180"/>

                </HBox>
            </VBox>

            <!-- LISTE DES MODULES PAR PROMO (scrollable) -->
            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent;
                               -fx-border-color: transparent;
                               -fx-background: #f1f5f9;">
                <VBox fx:id="promoContainer"
                      spacing="16"
                      style="-fx-padding: 24 40 40 40;
                             -fx-background-color: #f1f5f9;"/>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>