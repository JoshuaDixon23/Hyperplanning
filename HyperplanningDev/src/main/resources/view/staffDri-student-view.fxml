<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.univtln.projet.planning.controller.InternationalStudentController"
            styleClass="root"
            style="-fx-background-color: #f8f9fa;">

    <left>
        <fx:include source="/components/sidebar-staffDri.fxml" />
    </left>

    <center>
        <VBox spacing="20" styleClass="content" style="-fx-padding: 40;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT">
                <Label text="International Students"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="+ New student"
                        onAction="#handleAddStudent"
                        style="-fx-background-color: black; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 20; -fx-cursor: hand;"/>
            </HBox>

            <!-- Search bar -->
            <TextField fx:id="searchField"
                       promptText="search student..."
                       style="-fx-background-radius: 8; -fx-padding: 10; -fx-background-color: #e2e4e8; -fx-max-width: 400; -fx-border-width: 0;"/>

            <!-- Grid of student cards (3 columns) -->
            <ScrollPane fitToHeight="true" fitToWidth="true"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;"
                        VBox.vgrow="ALWAYS">
                <GridPane fx:id="studentsGrid"
                          hgap="20" vgap="20"
                          alignment="TOP_LEFT">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33" />
                        <ColumnConstraints percentWidth="33.33" />
                        <ColumnConstraints percentWidth="33.33" />
                    </columnConstraints>
                </GridPane>
            </ScrollPane>

            <!-- Pagination -->
            <HBox spacing="15" alignment="CENTER">
                <Button text="&lt;"
                        onAction="#handlePreviousPage"
                        style="-fx-background-color: #e2e4e8; -fx-text-fill: #333; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 20; -fx-cursor: hand;"/>
                <Label fx:id="pageIndicator" text="Page 1"
                       style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                <Button text="&gt;"
                        onAction="#handleNextPage"
                        style="-fx-background-color: #e2e4e8; -fx-text-fill: #333; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 20; -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>